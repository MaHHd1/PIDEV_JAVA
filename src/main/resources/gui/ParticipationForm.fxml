<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<AnchorPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ParticipationFormController">
    <stylesheets>
        <URL value="@../style.css" />
    </stylesheets>

    <ScrollPane fitToWidth="true" styleClass="scroll-pane" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <content>
            <VBox alignment="TOP_CENTER" spacing="25.0" styleClass="dashboard-content" maxWidth="800">
                <padding>
                    <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                </padding>

                <VBox spacing="8" alignment="CENTER">
                    <Label text="Confirmer votre Participation" styleClass="auth-hero-title" />
                    <Label fx:id="lblEventInfo" text="Événement: ..." styleClass="auth-hero-copy" />
                </VBox>

                <VBox spacing="25" styleClass="form-container" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-padding: 30;">
                    
                    <VBox spacing="12">
                        <Label text="Ma Motivation (Générée par IA) :" styleClass="form-label" style="-fx-font-weight: bold; -fx-text-fill: #2dd4bf;" />
                        <TextArea fx:id="descriptionField" prefWidth="400" prefHeight="180" wrapText="true" styleClass="input-area" promptText="Décrivez pourquoi vous souhaitez participer..." />
                        <HBox alignment="CENTER_RIGHT">
                            <Button onAction="#handleAI" text="✨ Régénérer avec l'IA" styleClass="button" style="-fx-background-color: rgba(45, 212, 191, 0.1); -fx-text-fill: #2dd4bf; -fx-border-color: #2dd4bf; -fx-border-radius: 5;" />
                        </HBox>
                    </VBox>

                    <Separator style="-fx-opacity: 0.1;" />

                    <VBox spacing="10" alignment="CENTER_LEFT">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="🌡️ Prévisions Météo :" styleClass="form-label" style="-fx-font-weight: bold;" />
                            <Label fx:id="weatherLabel" text="Chargement..." styleClass="status-label" style="-fx-text-fill: #94a3b8;" />
                        </HBox>
                        <Label text="Nous adaptons nos conseils en fonction du temps !" style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-style: italic;" />
                    </VBox>

                </VBox>

                <HBox spacing="20" alignment="CENTER">
                    <Button text="Confirmer l'Inscription" onAction="#handleSave" styleClass="primary-button" prefHeight="50" prefWidth="250" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <Button text="Annuler" onAction="#handleCancel" styleClass="danger-button" prefHeight="50" prefWidth="120" />
                </HBox>
            </VBox>
        </content>
    </ScrollPane>
</AnchorPane>
